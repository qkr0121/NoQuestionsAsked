  m_Script: {fileID: 11500000, guid: e94348b7fdbe1614d880e7ae95b14812, type: 3}
  m_Name: TutorialData
  m_EditorClassIdentifier: Assembly-CSharp::TutorialData
  pages:
  - title: "\uADFC\uBB34 \uC548\uB0B4"
    body: "\uC9C0\uC0C1\uC5D0\uC11C \uD06C\uB9AC\uC2A4\uD0C8\uC744 \uBAA8\uC544 \uC0C1\uB0A9\uD55C\uB2E4.\n\uB9C8\uAC10\uC744
      \uB118\uAE30\uBA74 \uACC4\uC57D\uC740 \uC885\uB8CC\uB41C\uB2E4.\n28\uC77C\uC744
      \uCC44\uC6B0\uBA74 \uADC0\uD658\uD560 \uC218 \uC788\uB2E4."
  - title: "\uC870\uC791"
    body: "WASD  \uC774\uB3D9\n\uB9C8\uC6B0\uC2A4  \uC870\uC900\n\uC88C\uD074\uB9AD 
      \uC0AC\uACA9\nR  \uC7AC\uC7A5\uC804\n1 \xB7 2 \xB7 3  \uBB34\uAE30 \uAD50\uCCB4\n4 
      \uC218\uB958\uD0C4 (\uC88C\uD074\uB9AD\uC73C\uB85C \uD22C\uCC99)\nQ  \uD68C\uBCF5\uC57D\n\uB9C8\uC6B0\uC2A4
      \uD720  \uC90C\nE  \uC0C1\uD638\uC791\uC6A9\nESC  \uBA54\uB274"
  - title: "\uAE30\uC9C0 \uC2DC\uC124"
    body: "\uBBF8\uC158\uBCF4\uB4DC  \uC0C1\uB0A9 \uC81C\uCD9C\n\uC18C\uD658\uAE30 
      \uC6E8\uC774\uBE0C \uC120\uD0DD\n\uC0C1\uC810  \uBB34\uAE30 \xB7 \uD0C4\uC57D
      \xB7 \uBC29\uC5B4\uBCBD \xB7 \uC18C\uBAA8\uD488\n\uCE68\uB300  \uCCB4\uB825
      \uD68C\uBCF5 (\uC2DC\uAC04\uC740 \uD750\uB974\uC9C0 \uC54A\uB294\uB2E4)\n\uCD9C\uAD6C 
      \uC9C0\uC0C1\uC73C\uB85C"
  - title: "\uD558\uB8E8\uC640 \uB9C8\uAC10"
    body: "\uC804\uD22C\uB97C \uB9C8\uCE58\uACE0 \uB3CC\uC544\uC624\uBA74 \uD558\uB8E8\uAC00
      \uC9C0\uB09C\uB2E4.\n\uB9C8\uAC10\uC740 7\uC77C\uB9C8\uB2E4 \uC628\uB2E4.\n\uB9C8\uAC10\uC77C\uAE4C\uC9C0
      \uC694\uAD6C \uAE08\uC561\uC744 \uC0C1\uB0A9\uD574\uC57C \uD55C\uB2E4."
  - title: "\uC804\uD22C"
    body: "\uC6E8\uC774\uBE0C\uB97C \uACE0\uB974\uACE0 \uC9C0\uC0C1\uC73C\uB85C \uB098\uAC04\uB2E4.\n\uBAA8\uB4E0
      \uC880\uBE44\uB97C \uCC98\uCE58\uD574\uC57C \uB3CC\uC544\uC62C \uC218 \uC788\uB2E4.\n\uACBD\uACE0\uAC00
      \uB728\uBA74 \uBC29\uC5B4\uBCBD \uB4A4\uB85C \uBB3C\uB7EC\uB09C\uB2E4.\n\uBC29\uC5B4\uBCBD\uC740
      \uC0C1\uC810\uC5D0\uC11C \uC124\uCE58\uD558\uACE0 \uC218\uB9AC\uD55C\uB2E4."
  - title: "\uB9C8\uBB34\uB9AC"
    body: "\uC774\uC0C1\uC774\uB2E4.\n\uC9C8\uBB38\uC740 \uBC1B\uC9C0 \uC54A\uB294\uB2E4."
