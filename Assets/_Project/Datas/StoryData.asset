  m_Script: {fileID: 11500000, guid: 913fb4b6d35c34c4dba472316b52e7d8, type: 3}
  m_Name: StoryData
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  pages:
  - title: "\uBC1C\uACAC"
    body: "\uBA3C \uBCC0\uBC29\uC758 \uD55C \uD589\uC131\uC5D0\uC11C <color=#E5483C>\uD06C\uB9AC\uC2A4\uD0C8
      \uAD11\uB9E5</color>\uC774 \uBC1C\uACAC\uB410\uB2E4."
    image: {fileID: 21300000, guid: 515242619b102bb4e87bd9f8e25cad64, type: 3}
  - title: "\uCC44\uAD74"
    body: "\uD68C\uC0AC\uB294 \uAD11\uBD80\uB4E4\uC744 \uD22C\uC785\uD558\uC5EC \uD06C\uB9AC\uC2A4\uD0C8
      \uCC44\uAD74\uC744 \uC2DC\uC791\uD588\uB2E4."
    image: {fileID: 21300000, guid: 5b7d047e39fb0b940a84218c8b917133, type: 3}
  - title: "\uC0AC\uACE0"
    body: "\uC5B4\uB290 \uB0A0, \uD06C\uB9AC\uC2A4\uD0C8\uC744 \uC5F0\uAD6C\uD558\uB358
      \uC5F0\uAD6C\uC18C\uAC00 \uD3ED\uBC1C\uD588\uB2E4.\n\uADF8\uB0A0 \uC774\uD6C4
      \uAD11\uBD80\uB4E4\uC740 <color=#E5483C>\uD06C\uB9AC\uC2A4\uD0C8 \uC880\uBE44</color>\uB85C
      \uBCC0\uD574 \uAC00\uAE30 \uC2DC\uC791\uD588\uB2E4."
    image: {fileID: 21300000, guid: b6bfc401d2f376342afc412afa5db042, type: 3}
  - title: "\uBC29\uCE58"
    body: "\uACB0\uAD6D, \uCC44\uAD74\uC740 \uC911\uB2E8. \uD589\uC131\uC740 \uADF8\uB300\uB85C
      \uBC84\uB824\uC84C\uB2E4."
    image: {fileID: 21300000, guid: cc5f11831a976924c90535c9902d4e56, type: 3}
  - title: "ROR \uD504\uB85C\uC81D\uD2B8"
    body: "\uC704\uAE30\uB294 \uAE30\uD68C. \uBAA8\uAE30\uC5C5\uC740 <color=#E5483C>ROR
      \uD504\uB85C\uC81D\uD2B8</color>\uB97C \uC2E4\uD589\uD588\uB2E4."
    image: {fileID: 21300000, guid: 04908d719e91fdc4aa4e54fb81c48747, type: 3}
  - title: "\uBAA8\uC9D1 \uACF5\uACE0"
    body: "\"<color=#E5483C>\uD06C\uB9AC\uC2A4\uD0C8 \uD68C\uC218 \uC778\uB825 \uBAA8\uC9D1</color>\n\uC9C0\uC6D0
      \uB3D9\uAE30 \uBD88\uBB38. \uC544\uB798 \uC11C\uB958\uC5D0 \uC11C\uBA85\uD560
      \uAC83.\""
    image: {fileID: 21300000, guid: a85135024f9838240bf36547ad9742f8, type: 3}
