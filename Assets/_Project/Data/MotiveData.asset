MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bed6b59ab93d729459b8580beefd69b2, type: 3}
  m_Name: MotiveData
  m_EditorClassIdentifier: Assembly-CSharp::MotiveData
  motives:
  - displayName: "\uB3C8"
    description: "\uBE5A\uB3C4 \uBC00\uB9B0 \uC6D4\uC138\uB3C4 \uC313\uC600\uB2E4.
      \uC704\uD5D8\uD558\uB2E4\uACE0 \uD588\uC9C0\uB9CC \uBCF4\uC218\uB9CC\uD07C\uC740
      \uD655\uC2E4\uD558\uB2E4\uACE0 \uD588\uB2E4."
    endingText: 
  - displayName: "\uC0AC\uBA74"
    description: "\uC9C0\uC6CC\uC9C0\uC9C0 \uC54A\uB294 \uC8C4\uC758 \uAE30\uB85D\uC774
      \uC788\uB2E4. \uC774\uACF3\uC5D0\uC11C \uBC84\uD2F0\uBA74 \uADF8 \uAE30\uB85D\uC744
      \uC9C0\uC6CC\uC900\uB2E4\uB294 \uC81C\uC548\uC744 \uBC1B\uC558\uB2E4."
    endingText: 
  - displayName: "\uAC00\uC871 \uCE58\uB8CC"
    description: "\uB204\uAD70\uAC00\uC758 \uBCD1\uC6D0\uBE44\uAC00 \uD544\uC694\uD558\uB2E4.
      \uC774 \uC77C\uC758 \uBCF4\uC218\uAC00 \uC720\uC77C\uD55C \uBC29\uBC95\uC774\uC5C8\uB2E4."
    endingText: 
  - displayName: "\uAE30\uC5B5\uC0C1\uC2E4"
    description: "\uB208\uC744 \uB5B4\uC744 \uB54C \uC774\uB984 \uB9D0\uACE0\uB294
      \uC544\uBB34\uAC83\uB3C4 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC558\uB2E4. \uC774\uACF3\uC774
      \uB0B4\uAC00 \uC788\uB358 \uACF3\uC778\uC9C0, \uB3C4\uB9DD\uCCD0 \uC628 \uACF3\uC778\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4."
    endingText: 
  - displayName: "\uBCF5\uC218"
    description: "\uB05D\uAE4C\uC9C0 \uCAD3\uACE0 \uC2F6\uC740 \uC0C1\uB300\uAC00
      \uC788\uB2E4. \uC774 \uC77C\uC758 \uB05D\uC5D0 \uADF8\uC5D0\uAC8C \uB2FF\uB294
      \uAE38\uC774 \uC788\uB2E4\uACE0 \uB4E4\uC5C8\uB2E4."
    endingText: 
  - displayName: "\uAC08 \uACF3 \uC5C6\uC74C"
    description: "\uB3CC\uC544\uAC08 \uC9D1\uB3C4, \uAE30\uB2E4\uB9AC\uB294 \uC0AC\uB78C\uB3C4
      \uC5C6\uB2E4. \uC7A0\uC790\uB9AC\uC640 \uC2DD\uC0AC\uB97C \uC8FC\uB294 \uACF3\uC774\uBA74
      \uCDA9\uBD84\uD588\uB2E4."
    endingText: 
  - displayName: "\uBA85\uC608"
    description: "\uC783\uC5B4\uBC84\uB9B0 \uBA85\uC608\uB97C \uB418\uCC3E\uACE0
      \uC2F6\uB2E4. \uBAA8\uB450\uAC00 \uD53C\uD55C \uC774 \uC77C\uC744 \uD574\uB0B4\uBA74
      \uB2EC\uB77C\uC9C8 \uAC70\uB77C \uBBFF\uB294\uB2E4."
    endingText: 
  - displayName: "\uC704\uC7A5 \uC7A0\uC785"
    description: "\uAC89\uC73C\uB85C\uB294 \uD3C9\uBC94\uD55C \uC9C0\uC6D0\uC790\uB2E4.
      \uC0AC\uC2E4\uC740 \uC774\uACF3\uC758 \uC815\uCCB4\uB97C \uBC1D\uD788\uB824\uACE0
      \uC228\uC5B4 \uB4E4\uC5B4\uC654\uB2E4."
    endingText: 
  - displayName: "\uD638\uAE30\uC2EC"
    description: "\uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uB294 \uC77C\uC790\uB9AC\uB77C\uB2C8,
      \uC7AC\uBC0C\uACA0\uB2E4! \uC774 \uC544\uB798\uC5D0 \uBB50\uAC00 \uC788\uC744\uAE4C,
      \uC5BC\uB978 \uAC00\uBCF4\uACE0 \uC2F6\uB2E4!"
    endingText: 
  offerCount: 4
