%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bed6b59ab93d729459b8580beefd69b2, type: 3}
  m_Name: MotiveData
  m_EditorClassIdentifier: Assembly-CSharp::MotiveData
  motives:
  - displayName: "\uB3C8"
    description: "\uBE5A\uB3C4 \uBC00\uB9B0 \uC6D4\uC138\uB3C4 \uC313\uC600\uB2E4.
      \uC704\uD5D8\uD558\uB2E4\uACE0 \uD588\uC9C0\uB9CC \uBCF4\uC218\uB9CC\uD07C\uC740
      \uD655\uC2E4\uD558\uB2E4\uACE0 \uD588\uB2E4."
    endingText: "\uD06C\uB9AC\uC2A4\uD0C8\uC740 \uD604\uAE08\uC774 \uB418\uC5B4 \uACC4\uC88C\uC5D0
      \uCC0D\uD614\uB2E4. \uBC00\uB9B0 \uC6D4\uC138\uC640 \uBE5A\uC744 \uAC1A\uACE0
      \uB098\uB2C8 \uB0A8\uB294 \uAC8C \uC5C6\uC5C8\uB2E4. \uC55E\uC73C\uB85C \uC5B4\uB5BB\uAC8C
      \uC0B4\uC544\uC57C \uD558\uB098... \uD55C \uBC88 \uB354 \uC9C0\uC6D0\uD574\uC57C
      \uD558\uB098."
  - displayName: "\uC0AC\uBA74"
    description: "\uC9C0\uC6CC\uC9C0\uC9C0 \uC54A\uB294 \uC8C4\uC758 \uAE30\uB85D\uC774
      \uC788\uB2E4. \uC774\uACF3\uC5D0\uC11C \uBC84\uD2F0\uBA74 \uADF8 \uAE30\uB85D\uC744
      \uC9C0\uC6CC\uC900\uB2E4\uB294 \uC81C\uC548\uC744 \uBC1B\uC558\uB2E4."
    endingText: "\uC11C\uB958\uC5D0\uC11C \uB0B4 \uC774\uB984 \uC606\uC758 \uAE30\uB85D\uC774
      \uC9C0\uC6CC\uC84C\uB2E4. \uB204\uAC00, \uC5B4\uB5BB\uAC8C \uC9C0\uC6E0\uB294\uC9C0\uB294
      \uC54C\uB824\uC8FC\uC9C0 \uC54A\uC558\uB2E4. \uC774\uC81C \uBC94\uC8C4\uB97C
      \uC800\uC9C8\uB7EC\uB3C4 \uC5EC\uAE30\uC5D0 \uC9C0\uC6D0\uB9CC \uD558\uBA74
      \uC544\uBB34 \uBB38\uC81C \uC5C6\uACA0\uB124..."
  - displayName: "\uAC00\uC871 \uCE58\uB8CC"
    description: "\uB204\uAD70\uAC00\uC758 \uBCD1\uC6D0\uBE44\uAC00 \uD544\uC694\uD558\uB2E4.
      \uC774 \uC77C\uC758 \uBCF4\uC218\uAC00 \uC720\uC77C\uD55C \uBC29\uBC95\uC774\uC5C8\uB2E4."
    endingText: "\uBC00\uB9B0 \uBCD1\uC6D0\uBE44\uB97C \uB0B4\uACE0, \uC55E\uC73C\uB85C
      \uBA87 \uB2EC\uC740 \uBB38\uC81C\uC5C6\uC774 \uCE58\uB8CC\uB97C \uBC1B\uAC8C
      \uD560 \uC218 \uC788\uACA0\uB2E4. \uD558\uC9C0\uB9CC \uADF8\uB2E4\uC74C\uC740?
      ...\uD55C \uBC88 \uB354 \uAC00\uC57C \uD558\uB098."
  - displayName: "\uAE30\uC5B5\uC0C1\uC2E4"
    description: "\uB208\uC744 \uB5B4\uC744 \uB54C \uC774\uB984 \uB9D0\uACE0\uB294
      \uC544\uBB34\uAC83\uB3C4 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC558\uB2E4. \uC774\uACF3\uC774
      \uB0B4\uAC00 \uC788\uB358 \uACF3\uC778\uC9C0, \uB3C4\uB9DD\uCCD0 \uC628 \uACF3\uC778\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4."
    endingText: "28\uC77C\uC744 \uBCF4\uB0B4\uACE0\uB3C4 \uAE30\uC5B5\uC740 \uB3CC\uC544\uC624\uC9C0
      \uC54A\uC558\uB2E4. \uC9C0\uAD6C\uC5D0\uC11C\uB3C4 \uB098\uB294 \uC5EC\uC804\uD788
      \uC544\uBB34\uAC83\uB3C4 \uBAA8\uB978\uB2E4. \uADF8\uACF3\uC5D0 \uB2E4\uC2DC
      \uAC00\uBA74, \uADF8\uB54C\uB294 \uBB50\uB77C\uB3C4 \uAE30\uC5B5\uB098\uB824\uB098..."
  - displayName: "\uBCF5\uC218"
    description: "\uB05D\uAE4C\uC9C0 \uCAD3\uACE0 \uC2F6\uC740 \uC0C1\uB300\uAC00
      \uC788\uB2E4. \uC774 \uC77C\uC758 \uB05D\uC5D0 \uADF8\uC5D0\uAC8C \uB2FF\uB294
      \uAE38\uC774 \uC788\uB2E4\uACE0 \uB4E4\uC5C8\uB2E4."
    endingText: "\uADF8\uC5D0\uAC8C \uB2FF\uB294 \uAE38\uC740 \uC788\uC5C8\uB2E4.
      \uD558\uC9C0\uB9CC \uC774 \uC77C\uC740 \uADF8 \uAE38\uC758 \uC785\uAD6C\uC5D0
      \uBD88\uACFC\uD588\uB2E4. \uB05D\uAE4C\uC9C0 \uAC00\uB824\uBA74 \uD55C \uBC88
      \uB354 \uC9C0\uC6D0\uD574\uC57C \uD55C\uB2E4..."
  - displayName: "\uAC08 \uACF3 \uC5C6\uC74C"
    description: "\uB3CC\uC544\uAC08 \uC9D1\uB3C4, \uAE30\uB2E4\uB9AC\uB294 \uC0AC\uB78C\uB3C4
      \uC5C6\uB2E4. \uC7A0\uC790\uB9AC\uC640 \uC2DD\uC0AC\uB97C \uC8FC\uB294 \uACF3\uC774\uBA74
      \uCDA9\uBD84\uD588\uB2E4."
    endingText: "28\uC77C \uB3D9\uC548\uC740 \uC7A0\uC790\uB9AC\uC640 \uC2DD\uC0AC
      \uAC71\uC815\uC774 \uC5C6\uC5C8\uB2E4. \uC9C0\uAD6C\uB85C \uB3CC\uC544\uC624\uB2C8
      \uB3CC\uC544\uAC08 \uC9D1\uC740 \uC5EC\uC804\uD788 \uC5C6\uB2E4. \uCC28\uB77C\uB9AC
      \uD55C \uBC88 \uB354 \uC9C0\uC6D0\uD560\uAE4C... \uAC70\uAE30\uC5D4 \uCD5C\uC18C\uD55C
      \uCE68\uB300\uB294 \uC788\uC5C8\uB294\uB370."
  - displayName: "\uBA85\uC608"
    description: "\uC783\uC5B4\uBC84\uB9B0 \uBA85\uC608\uB97C \uB418\uCC3E\uACE0
      \uC2F6\uB2E4. \uBAA8\uB450\uAC00 \uD53C\uD55C \uC774 \uC77C\uC744 \uD574\uB0B4\uBA74
      \uB2EC\uB77C\uC9C8 \uAC70\uB77C \uBBFF\uB294\uB2E4."
    endingText: "\uBAA8\uB450\uAC00 \uD53C\uD55C \uC77C\uC744 \uB05D\uAE4C\uC9C0
      \uD574\uB0C8\uB2E4. \uD558\uC9C0\uB9CC \uC774 \uC77C\uC744 \uC544\uB294 \uC0AC\uB78C\uC740
      \uC9C0\uAD6C\uC5D0 \uC5C6\uB2E4. \uC544\uC9C1 \uBD80\uC871\uD55C \uAC78\uAE4C...
      \uD55C \uBC88 \uB354 \uD574\uB0B4\uBA74 \uB204\uAD70\uAC00\uB294 \uC54C\uC544\uC904\uAE4C."
  - displayName: "\uC704\uC7A5 \uC7A0\uC785"
    description: "\uAC89\uC73C\uB85C\uB294 \uD3C9\uBC94\uD55C \uC9C0\uC6D0\uC790\uB2E4.
      \uC0AC\uC2E4\uC740 \uC774\uACF3\uC758 \uC815\uCCB4\uB97C \uBC1D\uD788\uB824\uACE0
      \uC228\uC5B4 \uB4E4\uC5B4\uC654\uB2E4."
    endingText: "\uC544\uBB34\uB3C4 \uB098\uB97C \uC758\uC2EC\uD558\uC9C0 \uC54A\uC558\uB2E4.
      \uC560\uCD08\uC5D0 \uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uB294 \uACF3\uC774\uC5C8\uB2E4.
      \uBCF4\uACE0\uC11C\uC5D0 \uC4F8 \uC218 \uC788\uB294 \uAC74 \uADF8 \uD55C \uC904\uBFD0\uC774\uB2E4.
      \uC99D\uAC70\uB97C \uAC00\uC838\uC624\uB824\uBA74 \uD55C \uBC88 \uB354 \uB4E4\uC5B4\uAC00\uC57C
      \uD558\uB098..."
  - displayName: "\uD638\uAE30\uC2EC"
    description: "\uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uB294 \uC77C\uC790\uB9AC\uB77C\uB2C8,
      \uC7AC\uBC0C\uACA0\uB2E4! \uADF8\uACF3\uC5D4 \uBB50\uAC00 \uC788\uC744\uAE4C,
      \uC5BC\uB978 \uAC00\uBCF4\uACE0 \uC2F6\uC5B4!"
    endingText: "\uADF8\uACF3\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uD6E8\uC52C \uC7AC\uBBF8\uC788\uC5C8\uC5B4!
      \uC544\uC9C1 \uB2E4 \uBCF4\uC9C0 \uBABB\uD55C \uAE30\uBD84\uC778\uB370... \uD55C
      \uBC88\uB9CC \uB354 \uC9C0\uC6D0\uD574\uBCFC\uAE4C?"
  offerCount: 4
  noAnswerEndingText: "\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4. \uC544\uBB34\uB3C4
    \uB2E4\uC2DC \uBB3B\uC9C0 \uC54A\uC558\uB2E4. \uC774\uC720 \uC5C6\uC774 \uC2DC\uC791\uD55C
    \uC77C\uC740 \uC774\uC720 \uC5C6\uC774 \uB05D\uB0AC\uB294\uB370, \uC65C \uB2E4\uC74C
    \uC9C0\uC6D0\uC11C\uAC00 \uBA38\uB9BF\uC18D\uC5D0 \uB0A8\uC544 \uC788\uC744\uAE4C."
